# Configuración para el servidor en la nube (VPS). Copia como ".env" en el VPS.

# Tu dominio, ya apuntando a la IP del VPS (registro A en el DNS).
# Ej. stronggym.mx  ·  Si todavía no tienes dominio usa  :80  y COOKIE_SEGURA=0
DOMINIO=stronggym.mx

# Clave larga para que recepción pueda sincronizar (la MISMA va en el .env de recepción).
# Genera una con:  openssl rand -hex 24
SYNC_TOKEN=

# Mismas contraseñas iniciales que en recepción
ADMIN_PASSWORD_INICIAL=
DUENO_PASSWORD_INICIAL=

# 1 = cookies solo por https (déjalo en 1 cuando ya tengas dominio)
COOKIE_SEGURA=1
