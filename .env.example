# =====================================================================
#  Strong Gym · configuración
#  Copia este archivo como ".env" y llena los datos.
#  (INICIAR-STRONG-GYM.bat lo copia solo la primera vez.)
# =====================================================================

# local = computadora de recepción  ·  nube = servidor en internet
MODO=local

# Puerto donde se abre el sistema (http://localhost:3000)
PORT=3000

# Contraseñas de la PRIMERA vez que arranca (después se cambian en "Mi cuenta").
# Usa las mismas en recepción y en la nube.
ADMIN_PASSWORD_INICIAL=
DUENO_PASSWORD_INICIAL=

# ---------- Sincronización con la nube (solo en recepción) ----------
# Dirección del sitio en internet, ej. https://strong-gym.onrender.com
NUBE_URL=
# La misma clave larga que tiene la nube en SYNC_TOKEN (mínimo 16 caracteres)
SYNC_TOKEN=
# Cada cuántos segundos sincroniza
SYNC_INTERVALO_SEG=60

# Cuántos días de respaldos diarios se guardan en datos/respaldos
RESPALDOS_DIAS=14
